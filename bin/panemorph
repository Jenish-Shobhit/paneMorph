#!/bin/sh
# paneMorph launcher. herdr runs this from the plugin root; it starts the
# release binary built with `cargo build --release`.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary="$root/target/release/panemorph"
if [ ! -x "$binary" ]; then
    echo "paneMorph is not built. Run: cargo build --release (in $root)" >&2
    exit 127
fi
exec "$binary" "$@"
